{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--headless",
          "--browser",
          "chromium",
          "--isolated",
          "--output-dir",
          "/tmp/opencode/playwright-mcp"
        ]
      }
    }
  }
}